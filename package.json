{
  "name": "witchspace",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx tools/build-site.ts && vite",
    "build": "tsc --noEmit && tsx tools/build-site.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate.ts",
    "sim:docking": "tsx tools/simulate-docking.ts",
    "site": "tsx tools/build-site.ts",
    "cards": "tsx tools/build-site.ts && node tools/share-cards.mjs",
    "test": "vitest run",
    "preview:headers": "npm run build && tsx tools/serve-dist.ts",
    "notebook": "tsx tools/notebook.ts"
  },
  "license": "GPL-3.0-only",
  "description": "An open-source, browser-based space trading game - a love letter to Elite (1984).",
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "lightweight-charts": "5.2.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "marked": "^18.1.1",
    "mp4-muxer": "^5.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/witchspace-game/witchspace.git"
  },
  "homepage": "https://witchspace.org.uk"
}
