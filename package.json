{
  "name": "witchspace",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx tools/build-site.ts && vite",
    "build": "tsc --noEmit && tsx tools/build-site.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate.ts",
    "sim:docking": "tsx tools/simulate-docking.ts",
    "site": "tsx tools/build-site.ts"
