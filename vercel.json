{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/careers",
      "destination": "/jobs/",
      "permanent": true
    },
    {
      "source": "/careers/",
      "destination": "/jobs/",
      "permanent": true
    },
    {
      "source": "/careers/:path*",
      "destination": "/jobs/",
      "permanent": true
    },
    {
      "source": "/companies",
      "destination": "/jobs/",
      "permanent": false
    },
    {
      "source": "/companies/",
      "destination": "/jobs/",
      "permanent": false
    },
    {
      "source": "/contribute",
      "destination": "/get-involved/",
      "permanent": true
    },
    {
      "source": "/contribute/",
      "destination": "/get-involved/",
      "permanent": true
    },
    {
      "source": "/contributing",
      "destination": "/get-involved/",
      "permanent": true
    },
    {
      "source": "/contributing/",
      "destination": "/get-involved/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/clip/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|facebookcatalog|WhatsApp|Cardyb|Mastodon|Embedly|Iframely|SkypeUriPreview|vkShare).*"
        }
      ],
      "destination": "https://space.witchspace.org.uk/clip-card/:id"
    },
    {
      "source": "/clip/:id",
      "destination": "/play/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://vercel.live https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://vercel.live https://vercel.com https://res.cloudinary.com; media-src 'self' https://res.cloudinary.com; connect-src 'self' https://vercel.live wss://ws-us3.pusher.com wss://space.witchspace.org.uk https://space.witchspace.org.uk; frame-src https://vercel.live https://challenges.cloudflare.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
